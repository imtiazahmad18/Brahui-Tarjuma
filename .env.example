# ==============================================================================
# Brahui Tarjuma (.env.example)
# Copy this file to .env.local and fill in your Supabase credentials
# ==============================================================================

# Supabase Project URL (From Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (From Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Keep Secret! Only needed for server admin overrides if any)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Base Site URL (For Canonical URLs, Open Graph, RSS feed, and Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
